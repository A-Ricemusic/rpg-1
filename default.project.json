{
  "name": "rpg-game-1",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "out/ReplicatedStorage/Shared"
      },
      "rbxts_include": {
        "$path": "include"
      },
      "rbxts_packages": {
        "$className": "Folder",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          },
          "@rbxts-js": {
            "$path": "node_modules/@rbxts-js"
          }
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "out/ServerScriptService"
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "out/StarterPlayer/StarterPlayerScripts"
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$path": "out/StarterGui"
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true
      }
    }
  }
}
